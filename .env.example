# =========================================================================
# GoBharat EV - Environment Configuration Template
# =========================================================================
# Copy this file to a new file named '.env' in the same directory:
# cp .env.example .env
#
# DO NOT commit the '.env' file containing actual secrets to source control.
# =========================================================================

# -------------------------------------------------------------------------
# Security & Session Authentication
# -------------------------------------------------------------------------
# Cryptographic key for JWT token hashing (Generate a strong random hexadecimal value in production)
# e.g., openssl rand -hex 32
SECRET_KEY=7d4b4a11f26a11394c8b2d41b8a5d3c8c24f6ae9bcfd9f4e244fe7ad54b51815
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------------------------
# Database and Middleware Cache Links
# -------------------------------------------------------------------------
# SQLite in-memory fallback connection (default) or production-ready PostgreSQL link
DATABASE_URL=postgresql+psycopg://postgres:ev_charging_password@localhost:5432/ev_charging?connect_timeout=3
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------------------
# Third-Party API Credentials (Mocks enabled if left blank)
# -------------------------------------------------------------------------
# Google Maps API for geocoding services (optional)
GOOGLE_MAPS_API_KEY=

# Stripe Merchant secret key for mock payment intent settlements (optional)
STRIPE_API_KEY=mock_stripe_key_sk_test
